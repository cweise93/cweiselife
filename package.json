{
  "name": "cweise-com-authority-hub",
  "version": "1.0.0",
  "description": "Clean Angular Material homepage for cweise.com repositioned as a professional thought-leadership and credibility hub.",
  "scripts": {
    "ng": "ng",
    "c2pa:verify": "node tools/verify-c2pa.mjs",
    "seo:images": "node tools/generate-social-preview-images.mjs",
    "seo:generate": "node tools/generate-seo-artifacts.mjs",
    "prebuild": "npm run seo:images && npm run seo:generate",
    "start": "ng serve",
    "build": "ng build",
    "site:verify": "node tools/verify-site-compliance.mjs",
    "site:compliance": "npm run build && npm run site:verify",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:cweise-com-authority-hub": "node dist/server/server.mjs"
  },
  "private": true,
  "engines": {
    "node": ">=22.22.3",
    "npm": ">=11"
  },
  "dependencies": {
    "@angular/animations": "^22.0.2",
    "@angular/cdk": "^22.0.2",
    "@angular/common": "^22.0.2",
    "@angular/compiler": "^22.0.2",
    "@angular/core": "^22.0.2",
    "@angular/forms": "^22.0.2",
    "@angular/material": "^22.0.2",
    "@angular/platform-browser": "^22.0.2",
    "@angular/platform-server": "^22.0.2",
    "@angular/router": "^22.0.2",
    "@angular/ssr": "^22.0.3",
    "d3": "^7.9.0",
    "express": "^5.2.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.3",
    "@angular/cli": "^22.0.3",
    "@angular/compiler-cli": "^22.0.2",
    "@types/d3": "^7.4.3",
    "@types/express": "^5.0.6",
    "@types/jasmine": "^6.0.0",
    "@types/node": "^20.19.43",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "^6.3.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.2.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "hono": "4.12.26",
    "piscina": "5.2.0",
    "qs": "6.15.2",
    "tmp": "0.2.7",
    "undici": "7.28.0",
    "vite": "7.3.5",
    "ws": "8.21.0"
  }
}
